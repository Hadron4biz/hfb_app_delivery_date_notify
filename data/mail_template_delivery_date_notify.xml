<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="mail_template_delivery_date_delay" model="mail.template">
        <field name="name">Sale Order: Delivery Date Change - Delay</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">{{ object.company_id.name }} - delivery date update for order {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-size:14px;">
                <p>Dear Customer,</p>
                <p>
                    we would like to let you know that the delivery date for
                    order
                    <strong t-out="object.name or ''">S00001</strong>
                    <t t-if="object.client_order_ref"> (your reference: <t t-out="object.client_order_ref"/>)</t>
                    has been <strong>pushed back</strong>.
                </p>
                <table style="border-collapse:collapse;margin:12px 0;">
                    <tr>
                        <td style="padding:2px 12px 2px 0;color:#666;">Previous delivery date:</td>
                        <td style="padding:2px 0;"><t t-out="format_date(object.x_ddn_baseline_date) or ''">09/01/2026</t></td>
                    </tr>
                    <tr>
                        <td style="padding:2px 12px 2px 0;color:#666;">New delivery date:</td>
                        <td style="padding:2px 0;"><strong t-out="format_date(object.commitment_date) or ''">09/05/2026</strong></td>
                    </tr>
                </table>
                <p>
                    We apologize for the delay and any inconvenience it may
                    cause. Please get in touch if you have any questions.
                </p>
                <p>
                    Kind regards,<br/>
                    <t t-out="object.company_id.name or ''">Your Company</t>
                </p>
            </div>
        </field>
    </record>

    <record id="mail_template_delivery_date_earlier" model="mail.template">
        <field name="name">Sale Order: Delivery Date Change - Earlier</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">{{ object.company_id.name }} - earlier delivery date for order {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-size:14px;">
                <p>Dear Customer,</p>
                <p>
                    good news - the delivery date for order
                    <strong t-out="object.name or ''">S00001</strong>
                    <t t-if="object.client_order_ref"> (your reference: <t t-out="object.client_order_ref"/>)</t>
                    has been <strong>moved up</strong>.
                </p>
                <table style="border-collapse:collapse;margin:12px 0;">
                    <tr>
                        <td style="padding:2px 12px 2px 0;color:#666;">Previous delivery date:</td>
                        <td style="padding:2px 0;"><t t-out="format_date(object.x_ddn_baseline_date) or ''">09/10/2026</t></td>
                    </tr>
                    <tr>
                        <td style="padding:2px 12px 2px 0;color:#666;">New delivery date:</td>
                        <td style="padding:2px 0;"><strong t-out="format_date(object.commitment_date) or ''">09/05/2026</strong></td>
                    </tr>
                </table>
                <p>Please get in touch if you have any questions.</p>
                <p>
                    Kind regards,<br/>
                    <t t-out="object.company_id.name or ''">Your Company</t>
                </p>
            </div>
        </field>
    </record>

</odoo>
